# Database (Docker network uses 'db' as hostname)
POSTGRES_USER=bageatteria
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=bageatteria
DB_HOST=db
DB_PORT=5432

# Security - CHANGE ALL OF THESE IN PRODUCTION!
# Сгенерируй: openssl rand -hex 32
SECRET_KEY=generate_with_openssl_rand_hex_32
# Access-токен живёт 60 минут, refresh (cookie) — 14 дней.
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=20160
JWT_ALGORITHM=HS256
ADMIN_COOKIE_SECRET=generate_another_random_string
ADMIN_USERNAME=your_admin_username
# bcrypt-хэш пароля. Сгенерировать: python -m scripts.hash_admin_password
ADMIN_PASSWORD_HASH=
# Plaintext-пароль — игнорируется если задан ADMIN_PASSWORD_HASH. В проде должен быть пустым.
ADMIN_PASSWORD=

# CORS: список разрешённых origin через запятую (БЕЗ пробелов и trailing slash).
# В production должен быть НЕпустым — иначе бэкенд не запустится.
CORS_ORIGINS=https://bageatteria.pro,https://www.bageatteria.pro,https://admin.bageatteria.pro

# App
APP_ENV=production
BASE_URL=https://api.bageatteria.pro

# Telegram Bots (if used)
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# AUTH_BOT_TOKEN=your_auth_bot_token
