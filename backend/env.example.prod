# Database (Docker network uses 'db' as hostname)
POSTGRES_USER=bageatteria
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=bageatteria
DB_HOST=db
DB_PORT=5432

# Security - CHANGE ALL OF THESE IN PRODUCTION!
SECRET_KEY=generate_with_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=43200
JWT_ALGORITHM=HS256
ADMIN_COOKIE_SECRET=generate_another_random_string
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_strong_admin_password

# App
APP_ENV=production
BASE_URL=https://api.slytn.ru

